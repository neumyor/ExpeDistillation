# Copy to .env and fill in the values. Never commit .env.
# Only variable names and explanations live here.

# --- LLM endpoint (OpenAI-compatible; serves both strong and weak models) ---
EXPEDISTILL_LLM_ENDPOINT=        # base URL, e.g. https://host/v1
EXPEDISTILL_LLM_API_KEY=         # API key; loaded into process env only, never logged
EXPEDISTILL_LLM_PROVIDER=        # optional: provider name (llm/providers.py table), default openai_compat

# --- Local benchmark eval repos (outer workspace) ---
EXPEDISTILL_SEARCHQA_EVAL_DIR=   # path to benchmark/searchqa-eval
EXPEDISTILL_SEARCHQA_MAX_STEPS=  # optional: per-episode SearchQA step budget, default 6
EXPEDISTILL_ALFWORLD_EVAL_DIR=   # path to benchmark/alfworld-eval
EXPEDISTILL_ALFWORLD_VENV=       # python executable inside the alfworld-eval venv
EXPEDISTILL_ALFWORLD_MAX_STEPS=  # optional: per-episode ALFWorld step budget, default 50
ALFWORLD_DATA=                   # see outer AGENTS.md for the three ALFWORLD_* vars
ALFWORLD_CONFIG=
ALFWORLD_BENCH_SRC=              # optional for the bridge today: forwarded to the episode
                                 # subprocess, but the eval-repo env does not read it; kept
                                 # because outer AGENTS.md still names it

# --- TerminalBench benchmark host ---
EXPEDISTILL_TB_HOST=             # user@host for ssh (BatchMode, key auth); `local` when the driver runs on the benchmark host
EXPEDISTILL_TB_KEY=              # path to the ssh private key (not needed when HOST=local)
EXPEDISTILL_TB_ROOT=             # absolute work root on the benchmark host
EXPEDISTILL_TB_ALLOWED_ROOTS=    # optional ":"-separated absolute prefixes the root must sit under (a shared host's guard)
EXPEDISTILL_TB_RUNNER=           # absolute path of the runner script on the benchmark host (required)
EXPEDISTILL_TB_ARCHIVE_ROOT=     # read-only campaign archive on the benchmark host (seed/analysis scripts only)
EXPEDISTILL_TB_POLL_SECONDS=     # remote poll interval, default 60
EXPEDISTILL_TB_DEADLINE_SECONDS= # per-trial remote deadline, default 16200 (agent 7200 + verifier 7200 + setup x3)
EXPEDISTILL_TB_SMOKE_MODEL=      # model name for the (manual) live smoke, optional

# --- Fake provider (EXPEDISTILL_LLM_PROVIDER=fake: smokes without an endpoint) ---
EXPEDISTILL_FAKE_PROVIDER_PLAN=   # JSON plan path; schema in src/expedistill/llm/fake_provider.py
