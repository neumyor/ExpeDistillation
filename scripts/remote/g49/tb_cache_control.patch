+# Explicit prompt-cache markers, only for the models named in TBENCH_CACHE_CONTROL_MODELS
+# (space separated). The agent puts cache_control on the last message of every request, which
+# makes an endpoint that caches only on markers (the Qwen gateway) reuse the previous step's
+# prefix. It changes no model output; a model that caches by itself is left out of the list.
+CACHE_CONTROL_LINES=""
+if [[ " ${TBENCH_CACHE_CONTROL_MODELS:-} " == *" ${MODEL_NAME:-} "* && -n "${TBENCH_CACHE_CONTROL_MODELS:-}" ]]; then
+  CACHE_CONTROL_LINES="        cache_control: last_message"
+fi
 # Terminus context/output ceilings. The ExpeDistillation plugin sets the
 # input cap per role (weak 256K, strong 512K); direct campaign runs keep
 # the historical 131072 / 65536 defaults.
@@ -221,6 +229,7 @@
